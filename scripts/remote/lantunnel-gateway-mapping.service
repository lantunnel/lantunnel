[Unit]
Description=Lantunnel 2.0 machine-wide UDP mapping service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/root/lantunnel
ExecStart=/root/lantunnel/lantunnel-gateway mapping serve
Restart=always
RestartSec=3
LimitNOFILE=65536
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target

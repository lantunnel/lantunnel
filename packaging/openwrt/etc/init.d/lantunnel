#!/bin/sh /etc/rc.common
# Lantunnel Client — headless Peer for OpenWrt.
#
# The router is already always on and already sits on the LAN, which makes it
# the natural place to run the Peer that exports that LAN to the rest of the
# Tunnel. Exporting a subnet only needs outbound dials, so this needs no
# kmod-tun, no ip-full, and no route or firewall changes.

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/lantunnel-client
# Config root. The Client puts its own files under $CONF_ROOT/app.
CONF_ROOT=/etc/lantunnel
PEERS_DIR="$CONF_ROOT/app/peers"
# Config lives on the flash overlay because it has to survive a reboot. A daily
# rotating log file must not: tmpfs keeps those writes in RAM, off the chip.
LOG_DIR=/var/log/lantunnel

# Tunnel ID from UCI, else the only imported profile. Profiles are stored as
# <tunnel-id>.peer, so the filename is the ID.
# Runs inside a command substitution, so nothing here may write to stdout
# except the ID itself. That is why config_load happens in the caller.
resolve_tunnel_id() {
	local configured
	config_get configured main tunnel_id ''
	if [ -n "$configured" ]; then
		echo "$configured"
		return 0
	fi

	local found count
	count=0
	for peer in "$PEERS_DIR"/*.peer; do
		[ -f "$peer" ] || continue
		found="$(basename "$peer" .peer)"
		count=$((count + 1))
	done

	if [ "$count" = 1 ]; then
		echo "$found"
		return 0
	fi
	if [ "$count" = 0 ]; then
		echo "lantunnel: no Peer profile imported. Run:" >&2
		echo "  TUNNEL_PROXY_APP_CONFIG_DIR=$CONF_ROOT $PROG tunnel import <FILE.peer>" >&2
	else
		echo "lantunnel: $count profiles imported; set the Tunnel ID with:" >&2
		echo "  uci set lantunnel.main.tunnel_id=<TUNNEL_ID> && uci commit lantunnel" >&2
	fi
	return 1
}

start_service() {
	if [ ! -x "$PROG" ]; then
		echo "lantunnel: $PROG is missing or not executable" >&2
		return 1
	fi

	mkdir -p "$CONF_ROOT" "$LOG_DIR"
	chmod 0700 "$CONF_ROOT"

	config_load lantunnel >/dev/null 2>&1

	local tunnel_id
	tunnel_id="$(resolve_tunnel_id)" || return 1

	procd_open_instance lantunnel
	procd_set_param command "$PROG" connect "$tunnel_id"
	procd_set_param env \
		TUNNEL_PROXY_APP_CONFIG_DIR="$CONF_ROOT" \
		LANTUNNEL_LOG_DIR="$LOG_DIR"
	# Retry forever. A tunnel that gives up after N attempts is a tunnel
	# somebody has to drive to the site to restart.
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
